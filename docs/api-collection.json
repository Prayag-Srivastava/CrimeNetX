{
  "info": {
    "name": "CrimeNetX API (SIH26189)",
    "_postman_id": "crimenetx-api-sih26189",
    "description": "CrimeNetX — AI-Powered Criminal Network Analysis System.\n\nTwo services:\n- Node REST + WebSocket backend  -> http://localhost:5000/api  (auth, cases, suspects, evidence, network, alerts, analytics, dossier)\n- FastAPI AI/ML backend          -> http://localhost:8000/api  (NLP, graph ML, vision, vector/cross-reference, financial, agents, dossier)\n\nAuth flow: POST /auth/login -> copy `accessToken` from response into the `accessToken` collection variable (or the Authorization header of each request).\nDemo users (password Test@1234): investigator@crimenetx.gov.in / dsp@crimenetx.gov.in / sp@crimenetx.gov.in / dgp@crimenetx.gov.in\n\nVariables: nodeBase (http://localhost:5000), aiBase (http://localhost:8000), accessToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "nodeBase", "value": "http://localhost:5000" },
    { "key": "aiBase", "value": "http://localhost:8000" },
    { "key": "accessToken", "value": "" },
    { "key": "caseId", "value": "PUN-2024-0118" },
    { "key": "caseDbId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "01 · Auth (Node)",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{nodeBase}}/api/auth/register", "host": ["{{nodeBase}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A. K. Sharma\",\n  \"email\": \"investigator@crimenetx.gov.in\",\n  \"password\": \"Test@1234\",\n  \"role\": \"INVESTIGATOR\",\n  \"department\": \"CID Pune\",\n  \"badgeNumber\": \"MH-CID-2214\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "if (body.user?.id) pm.collectionVariables.set('caseDbId', body.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{nodeBase}}/api/auth/login", "host": ["{{nodeBase}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"investigator@crimenetx.gov.in\",\n  \"password\": \"Test@1234\"\n}"
            }
          }
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{nodeBase}}/api/auth/refresh", "host": ["{{nodeBase}}"], "path": ["api", "auth", "refresh"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"<paste refresh token from login response>\"\n}" }
          }
        },
        {
          "name": "Me (current user)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{nodeBase}}/api/auth/me", "host": ["{{nodeBase}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "02 · Cases (Node)",
      "item": [
        {
          "name": "List cases",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{nodeBase}}/api/cases?search=&status=&priority=",
              "host": ["{{nodeBase}}"],
              "path": ["api", "cases"],
              "query": [
                { "key": "search", "value": "", "disabled": true },
                { "key": "status", "value": "", "disabled": true },
                { "key": "priority", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create case",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{nodeBase}}/api/cases", "host": ["{{nodeBase}}"], "path": ["api", "cases"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caseNumber\": \"PUN-2024-0118\",\n  \"title\": \"Organized extortion racket — Kondhwa belt\",\n  \"description\": \"Multi-district extortion and money-laundering network operating across Pune, Mumbai and Nashik.\",\n  \"status\": \"OPEN\",\n  \"priority\": \"HIGH\",\n  \"jurisdiction\": \"Pune City Police\",\n  \"firNumber\": \"FIR/PUN/2024/0118\"\n}"
            }
          }
        },
        {
          "name": "Get case",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{nodeBase}}/api/cases/:caseId",
              "host": ["{{nodeBase}}"],
              "path": ["api", "cases", ":caseId"],
              "variable": [{ "key": "caseId", "value": "PUN-2024-0118" }]
            }
          }
        },
        {
          "name": "Update case",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{nodeBase}}/api/cases/:caseId",
              "host": ["{{nodeBase}}"],
              "path": ["api", "cases", ":caseId"],
              "variable": [{ "key": "caseId", "value": "PUN-2024-0118" }]
            },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"UNDER_INVESTIGATION\",\n  \"priority\": \"CRITICAL\"\n}" }
          }
        },
        {
          "name": "Case stats",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{nodeBase}}/api/cases/:caseId/stats",
              "host": ["{{nodeBase}}"],
              "path": ["api", "cases", ":caseId", "stats"],
              "variable": [{ "key": "caseId", "value": "PUN-2024-0118" }]
            }
          }
        },
        {
          "name": "Delete case (SP+)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{nodeBase}}/api/cases/:caseId",
              "host": ["{{nodeBase}}"],
              "path": ["api", "cases", ":caseId"],
              "variable": [{ "key": "caseId", "value": "PUN-2024-0118" }]
            }
          }
        }
      ]
    },
