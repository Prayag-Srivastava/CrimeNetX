          }
        },
        {
          "name": "Delete suspect (DSP+)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{nodeBase}}/api/suspects/:id",
              "host": ["{{nodeBase}}"],
              "path": ["api", "suspects", ":id"],
              "variable": [{ "key": "id", "value": "" }]
