generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String
  passwordHash      String
  role              Role           @default(INVESTIGATOR)
  department        String         @default("")
  badgeNumber       String         @default("")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  auditLogs         AuditLog[]
  assignedCases     Case[]         @relation("AssignedCases")
  generatedDossiers Dossier[]
  uploadedEvidence  Evidence[]     @relation("UploadedEvidence")
  refreshTokens     RefreshToken[]

  @@index([role])
  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  ipAddress  String   @default("")
  metadata   Json?
  timestamp  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp])
}

model Case {
  id                     String         @id @default(cuid())
  caseNumber             String         @unique
  title                  String
  description            String         @default("")
  status                 CaseStatus     @default(OPEN)
  priority               CasePriority   @default(MEDIUM)
  jurisdiction           String         @default("")
  source                 CaseSource     @default(MANUAL)
  externalId             String         @default("")
  syncedAt               DateTime?
  assignedInvestigatorId String?
  startDate              DateTime       @default(now())
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  alerts                 Alert[]
  callRecords            CallRecord[]
  assignedInvestigator   User?          @relation("AssignedCases", fields: [assignedInvestigatorId], references: [id])
  dossiers               Dossier[]
  entities               Entity[]
  evidence               Evidence[]
  modusOperandi          ModusOperandi?
  edges                  NetworkEdge[]
  nodes                  NetworkNode[]
  transactions           Transaction[]
  suspects               Suspect[]      @relation("CaseSuspects")

  @@index([assignedInvestigatorId])
  @@index([status])
  @@index([jurisdiction])
  @@index([createdAt])
}

model Suspect {
  id              String    @id @default(cuid())
  name            String
  aliases         String[]
  dob             DateTime?
  gender          String    @default("")
  address         String    @default("")
  phoneNumbers    String[]
  photoUrl        String    @default("")
  criminalHistory String[]  @default([])
  kingpinScore    Float     @default(0)
  role            GraphRole @default(EXECUTOR)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  cases           Case[]    @relation("CaseSuspects")

  @@index([name])
  @@index([kingpinScore])
}

model Entity {
  id            String        @id @default(cuid())
  caseId        String
  type          EntityType
  value         String
  confidence    Float         @default(0.8)
  extractedFrom String        @default("")
  layer         String        @default("spacy")
  createdAt     DateTime      @default(now())
  case          Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  nodes         NetworkNode[]

  @@index([caseId])
  @@index([type, value])
  @@index([value])
}

model NetworkNode {
  id           String        @id @default(cuid())
  caseId       String
  entityId     String?
  label        String
  x            Float         @default(0)
  y            Float         @default(0)
  kingpinScore Float         @default(0)
  role         GraphRole     @default(EXECUTOR)
  centrality   Json?
  createdAt    DateTime      @default(now())
  outEdges     NetworkEdge[] @relation("EdgeSource")
  inEdges      NetworkEdge[] @relation("EdgeTarget")
  case         Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  entity       Entity?       @relation(fields: [entityId], references: [id])

  @@index([caseId])
  @@index([role])
}

model NetworkEdge {
  id           String       @id @default(cuid())
  caseId       String
  sourceId     String
  targetId     String
  relationType RelationType
  weight       Float        @default(1)
  evidence     String       @default("")
  createdAt    DateTime     @default(now())
  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  source       NetworkNode  @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target       NetworkNode  @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([sourceId])
  @@index([targetId])
}

model Evidence {
  id         String       @id @default(cuid())
  caseId     String
  type       EvidenceType
  fileName   String
  s3Url      String       @default("")
  sha256Hash String       @default("")
  uploadedBy String
  gpsLat     Float?
  gpsLng     Float?
  capturedAt DateTime?
  uploadedAt DateTime     @default(now())
  case       Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploader   User         @relation("UploadedEvidence", fields: [uploadedBy], references: [id])

  @@index([caseId])
  @@index([sha256Hash])
  @@index([uploadedBy])
}

model Transaction {
  id              String   @id @default(cuid())
  caseId          String
  fromAccount     String
  toAccount       String
  amount          Float
  timestamp       DateTime @default(now())
  transactionType String   @default("NEFT")
  riskScore       Float    @default(0)
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([fromAccount])
  @@index([toAccount])
  @@index([timestamp])
}

model CallRecord {
  id          String   @id @default(cuid())
  caseId      String
  fromNumber  String
  toNumber    String
  durationSec Int      @default(0)
  callTime    DateTime @default(now())
  cellTower   String   @default("")
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([fromNumber])
  @@index([toNumber])
}

model Alert {
  id        String        @id @default(cuid())
  caseId    String
  type      AlertType
  severity  AlertSeverity @default(MEDIUM)
  message   String
  data      Json?
  resolved  Boolean       @default(false)
  createdAt DateTime      @default(now())
  case      Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([resolved])
  @@index([createdAt])
}

model ModusOperandi {
  id             String   @id @default(cuid())
  caseId         String   @unique
  fingerprint    Json
  similarCaseIds String[] @default([])
  createdAt      DateTime @default(now())
  case           Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model Dossier {
  id          String   @id @default(cuid())
  caseId      String
  generatedBy String
  s3Url       String   @default("")
  localPath   String   @default("")
  sha256Hash  String   @default("")
  pageCount   Int      @default(0)
  generatedAt DateTime @default(now())
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  generator   User     @relation(fields: [generatedBy], references: [id])

  @@index([caseId])
  @@index([generatedBy])
}

enum Role {
  INVESTIGATOR
  DSP
  SP
  DGP
}

enum CaseStatus {
  OPEN
  UNDER_INVESTIGATION
  PENDING_REVIEW
  CLOSED
  COLD
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EntityType {
  PERSON
  LOCATION
  PHONE
  VEHICLE
  ORGANIZATION
  BANK_ACCOUNT
  DATE
  ALIAS
  CRYPTO_WALLET
}

enum CaseSource {
  MANUAL
  CCTNS
  EMAIL
  WHATSAPP
  BULK
}

enum GraphRole {
  KINGPIN
  BROKER
  EXECUTOR
}

enum RelationType {
  phone_call
  financial_transfer
  family
  associate
  same_organization
  co_location
}

enum EvidenceType {
  FIR
  CDR
  BANK
  PHOTO
  DOCUMENT
  CCTV
}

enum AlertType {
  ANOMALY
  HIGH_RISK
  GHOST_LINK
  CROSS_REFERENCE
  NETWORK_UPDATE
  EVIDENCE_UPLOAD
  LAUNDERING_RISK
}

enum AlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
