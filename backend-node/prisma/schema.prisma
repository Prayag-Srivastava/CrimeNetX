// ============================================================
// CrimeNetX — Updated Prisma Schema
// New models: DocumentProvenance, EntityResolutionLog
// Modified models: NetworkNode, NetworkEdge, Case
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ──────────────────────────────────────────────────

enum Role {
  ADMIN
  INVESTIGATOR
  ANALYST
  CONSTABLE
  SUPERVISOR
}

enum RelationType {
  phone_call
  financial_transfer
  family
  associate
  same_organization
  co_location
  co_accused
  victim_of
  witness_to
}

enum PersonRole {
  VICTIM
  WITNESS
  ACCUSED
  ASSOCIATE
  UNKNOWN
}

enum DocumentType {
  FIR
  CDR
  BANK_STATEMENT
  SURVEILLANCE_NOTE
  OSINT_CAPTURE
  COMPLAINT
}

enum OCRStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}

enum TranslationStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED_NOT_NEEDED
}

enum ResolutionDecision {
  MERGE
  SPLIT
  REVIEW
  AUTO_MERGED
  AUTO_REJECTED
}

enum AdmissibilityStatus {
  CERTIFIED
  DEFECTIVE
  DEMANDED_NOT_GIVEN
  NOT_SOUGHT
  PENDING
}

enum TimelineState {
  RECORDED
  DELAYED
  IMPOSSIBLE
  ABSENT
}

enum EdgeInkType {
  OBSERVED
  PREDICTED
  HYPOTHESISED
}

// ── CORE MODELS ────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(INVESTIGATOR)
  badgeId   String?  @unique
  station   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases     Case[]
  auditLogs AuditLog[]
}

model Case {
  id          String   @id @default(cuid())
  firNumber   String   @unique
  title       String
  description String?  @db.Text
  status      String   @default("OPEN")
  district    String?
  state       String?
  offenceType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   String
  user        User     @relation(fields: [createdBy], references: [id])

  nodes             NetworkNode[]
  edges             NetworkEdge[]
  documents         DocumentProvenance[]
  resolutionLogs    EntityResolutionLog[]
  evidenceItems     EvidenceItem[]
  auditLogs         AuditLog[]
}

// ── DOCUMENT PROVENANCE (NEW) ──────────────────────────────
// Stores the complete chain from raw file → OCR → Translation → NER
// This is the court-admissible provenance record

model DocumentProvenance {
  id               String       @id @default(cuid())
  caseId           String
  documentType     DocumentType
  originalFilename String

  // Stage 0: Ingestion
  ingestionHash    String                    // SHA-256 of original uploaded file
  ingestionTime    DateTime     @default(now())

  // Stage 1: OCR
  rawOcrText       String?      @db.Text     // Exact Tesseract output (may be Hindi/Marathi)
  rawOcrHash       String?                   // SHA-256 of rawOcrText
  ocrLanguage      String?                   // "hin" | "mar" | "eng" | "tam" | "hin+eng"
  ocrConfidence    Float?                    // Average Tesseract confidence 0-100
  ocrStatus        OCRStatus    @default(PENDING)
  ocrPageCount     Int?

  // Stage 2: Translation
  translatedText   String?      @db.Text     // IndicTrans2 English output
  translatedHash   String?                   // SHA-256 of translatedText
  sourceLanguage   String?                   // Detected source language code
  translationModel String?                   // "ai4bharat/indictrans2-indic-en-dist-200M"
  translationStatus TranslationStatus @default(PENDING)

  // Stage 3: NER
  extractedEntities Json?                    // spaCy NER output with character offsets
  nerModel          String?                  // "en_core_web_trf"

  // Stage 5: Relationship Extraction
  relationshipSource String?                 // "GROQ_LLM" | "COOCCURRENCE" | "CDR_DIRECT" | "BANK_DIRECT"

  // Court admissibility
  admissibility    AdmissibilityStatus @default(PENDING)

  // Pipeline metadata
  pipelineVersion  String       @default("v2.1-ocr-splink")
  processedAt      DateTime?

  // Three-timestamp model
  eventTime        DateTime?                 // When the crime/event actually happened
  recordTime       DateTime?                 // When police wrote the record
  // ingestionTime is already above

  // Timeline quality
  timelineState    TimelineState @default(RECORDED)

  // Relations
  case             Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  nodes            NetworkNode[]

  @@index([caseId])
  @@index([ingestionHash])
}

// ── ENTITY RESOLUTION LOG (NEW) ────────────────────────────
// Tracks every Splink merge/split decision for audit

model EntityResolutionLog {
  id               String             @id @default(cuid())
  caseId           String
  sourceEntityName String                          // "Ravi K. Jadhav"
  targetEntityName String                          // "R. Jadhav"
  sourceNodeId     String?                         // Existing node ID if matched
  matchWeight      Float                            // Fellegi-Sunter log-odds weight
  matchProbability Float                            // 0.0 to 1.0
  decision         ResolutionDecision
  fieldScores      Json                             // {"first_name": 2.1, "phone": 3.5, ...}
  blockingKey      String?                          // Which blocking rule matched
  decidedBy        String                           // "SPLINK_AUTO" | "OFFICER_ID_123"
  decidedAt        DateTime           @default(now())

  case             Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([sourceEntityName, targetEntityName])
}

// ── NETWORK NODE (MODIFIED) ────────────────────────────────

model NetworkNode {
  id             String      @id @default(cuid())
  caseId         String
  label          String                    // Display name
  entityType     String                    // "PERSON" | "ORG" | "PHONE" | "VEHICLE" | "ACCOUNT" | "LOCATION"
  canonicalName  String?                   // Resolved name after Splink dedup
  aliases        Json?                     // ["Ravi Jadhav", "R. K. Jadhav", "रवि जाधव"]
  sourceLanguage String?                   // Original script language
  personRole     PersonRole  @default(UNKNOWN)
  roleSource     String?                   // Which document established this role
  attributes     Json?                     // Flexible metadata
  provenanceId   String?                   // Link to DocumentProvenance
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  case           Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  provenance     DocumentProvenance? @relation(fields: [provenanceId], references: [id])
  sourceEdges    NetworkEdge[] @relation("SourceEdges")
  targetEdges    NetworkEdge[] @relation("TargetEdges")

  @@index([caseId])
  @@index([entityType])
  @@index([canonicalName])
}

// ── NETWORK EDGE (MODIFIED) ────────────────────────────────

model NetworkEdge {
  id           String       @id @default(cuid())
  caseId       String
  sourceId     String
  targetId     String
  relationType RelationType
  inkType      EdgeInkType  @default(OBSERVED)    // NEW: Three-Ink classification
  weight       Float        @default(1)
  evidence     String       @default("") @db.Text
  sourceDocId  String?                             // NEW: Link to DocumentProvenance
  mechanism    String       @default("LLM")        // "LLM" | "COOCCURRENCE" | "CDR" | "BANK" | "GHOST_LINK"
  isVerified   Boolean      @default(false)         // NEW: Human verification flag
  createdAt    DateTime     @default(now())

  source       NetworkNode  @relation("SourceEdges", fields: [sourceId], references: [id], onDelete: Cascade)
  target       NetworkNode  @relation("TargetEdges", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([sourceId, targetId])
}

// ── EVIDENCE ITEM ──────────────────────────────────────────

model EvidenceItem {
  id          String   @id @default(cuid())
  caseId      String
  type        String
  title       String
  description String?  @db.Text
  fileUrl     String?
  hash        String?
  uploadedBy  String
  createdAt   DateTime @default(now())

  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// ── AUDIT LOG (ENHANCED) ───────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  caseId     String?
  userId     String?
  action     String                    // "recordIngest" | "entityMerge" | "edgeInfer" | "analystOverride" | "dataExport" | "certificateGenerate" | "accessDenied"
  details    Json?
  ipAddress  String?
  timestamp  DateTime @default(now())

  case       Case?    @relation(fields: [caseId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([caseId])
  @@index([userId])
  @@index([action])
  @@index([timestamp])
}