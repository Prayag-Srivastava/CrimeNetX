# ============================================================================
# CrimeNetX — Master Environment Reference Guide
# ============================================================================
# Copy this file to the three per-service .env files listed below and fill in
# YOUR OWN values. NEVER commit real keys. Every variable below is documented
# with where to obtain it.
#
#   -> frontend/.env.local      (Next.js frontend)
#   -> backend-node/.env        (Express REST + WebSocket server)
#   -> backend-ai/.env          (FastAPI AI/ML service)
#
# All three services also read DATABASE_URL / REDIS_URL / AWS_* shared config.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) AUTH & SECURITY
# ---------------------------------------------------------------------------
# JWT_SECRET  : 32+ char random string used to sign access tokens.
#                Generate with:  openssl rand -base64 48
JWT_SECRET=jwt_signing_secret_change_me_32_chars_min
# JWT_REFRESH_SECRET : separate secret for refresh tokens (rotate independently).
JWT_REFRESH_SECRET=refresh_secret_change_me_32_chars_min
# JWT_EXPIRY : access token lifetime, e.g. "15m", "1h".
JWT_EXPIRY=15m
# JWT_REFRESH_EXPIRY : refresh token lifetime, e.g. "7d", "30d".
JWT_REFRESH_EXPIRY=7d
# NEXTAUTH_SECRET : used by NextAuth.js on the frontend to encrypt session.
#                   Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=nextauth_secret_change_me
# NEXTAUTH_URL : public URL of the frontend, e.g. http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# 2) SERVICE PORTS & URLS
# ---------------------------------------------------------------------------
# PORT : port the Node backend listens on (default 5000).
PORT=5000
# NODE_ENV : development | production | test
NODE_ENV=development
# AI_SERVICE_URL : internal URL of the FastAPI service (Docker network name).
#                  Local run: http://localhost:8000 | Docker: http://backend-ai:8000
AI_SERVICE_URL=http://localhost:8000
# NODE_BACKEND_URL : URL of the Express service, used by FastAPI for callbacks.
NODE_BACKEND_URL=http://localhost:5000
# FRONTEND_URL : CORS origin for the frontend (Docker: http://localhost:3000).
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# 3) POSTGRESQL (backend-node + backend-ai both connect)
# ---------------------------------------------------------------------------
# DATABASE_URL : Prisma/psycopg connection string.
#   Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
#   Local:  postgresql://crimenetx:crimenetx@localhost:5432/crimenetx?schema=public
#   Docker: postgresql://crimenetx:crimenetx@postgres:5432/crimenetx?schema=public
DATABASE_URL=postgresql://crimenetx:crimenetx@localhost:5432/crimenetx?schema=public

# ---------------------------------------------------------------------------
# 4) REDIS (caching + WebSocket pub/sub)
# ---------------------------------------------------------------------------
# REDIS_URL : Redis connection string. Upstash-compatible (redis[s]://...).
#             Local/Docker: redis://localhost:6379  or  redis://redis:6379
#             Upstash example: rediss://default:XXXX@xxxx.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# 5) GROQ LLM API  (PRIMARY LLM — all text/reasoning tasks)
#    Get key at https://console.groq.com -> API Keys
#    Model: groq/compound-mini (free tier available at groq.com/console)
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL : model id used for agentic reasoning (default groq/compound-mini).
GROQ_MODEL=groq/compound-mini

# ---------------------------------------------------------------------------
# 6) GOOGLE GEMINI (VISION ONLY — CCTV/suspect-photo multimodal matching)
#    Get key at https://aistudio.google.com/apikey
#    NOTE: CrimeNetX uses Gemini ONLY for vision. All text/LLM reasoning uses
#    Groq because the Gemini free tier exhausts quickly under agentic load.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---------------------------------------------------------------------------
# 7) AWS S3 (evidence storage via presigned URLs)
#    Get keys at https://console.aws.amazon.com/iam -> Users -> Security creds
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-south-1
# AWS_S3_BUCKET : S3 bucket name for evidence + dossier storage.
AWS_S3_BUCKET=crimenetx-evidence

# ---------------------------------------------------------------------------
# 8) CHROMADB (vector store — local persistent mode)
# ---------------------------------------------------------------------------
# CHROMA_PERSIST_DIR : directory where ChromaDB persists embeddings.
CHROMA_PERSIST_DIR=./chroma_data

# ---------------------------------------------------------------------------
# 9) FRONTEND PUBLIC CONFIG (frontend/.env.local only — NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL : Node backend base URL reachable from the browser.
#   Local: http://localhost:5000/api  | Docker: http://localhost:5000/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# NEXT_PUBLIC_AI_API_URL : FastAPI base URL (used for direct AI calls/SSE).
#   Local: http://localhost:8000/api  | Docker: http://localhost:8000/api
NEXT_PUBLIC_AI_API_URL=http://localhost:8000/api
# NEXT_PUBLIC_SOCKET_URL : Socket.io server URL.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
